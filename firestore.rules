rules_version = '2';

// Sylvie family data model:
//   /families/{familyId}
//     members/{uid}        — one doc per family member
//     zones/{zoneId}       — safe zones
//     alerts/{alertId}     — exit/enter/offline alerts
//     presence/{uid}       — latest location + battery, one doc per member
//   /invites/{code}        — short-lived join codes → familyId
//
// Rules:
//   - everything requires auth
//   - a user may only read/write their own family's data
//   - a user may only overwrite their OWN presence/member doc
//   - only the admin may delete the family or remove members
//   - invites are world-readable (so a joiner can look up their code)
//     but only the creating family may write them

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isAdmin(familyId) {
      return isMember(familyId) &&
        get(/databases/$(database)/documents/families/$(familyId)).data.admin_id == request.auth.uid;
    }

    match /families/{familyId} {
      allow read: if isMember(familyId);
      // Creating a family: only you can set yourself as admin.
      allow create: if signedIn() && request.resource.data.admin_id == request.auth.uid;
      allow update: if isAdmin(familyId);
      allow delete: if isAdmin(familyId);

      match /members/{memberId} {
        allow read: if isMember(familyId);
        // You can create/update your own member doc; admin can edit anyone.
        allow create, update: if signedIn() &&
          (request.auth.uid == memberId || isAdmin(familyId));
        allow delete: if isAdmin(familyId);
      }

      match /zones/{zoneId} {
        allow read: if isMember(familyId);
        // For now any member can add zones; tighten to admin-only later if needed.
        allow create, update, delete: if isMember(familyId);
      }

      match /alerts/{alertId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId);
        // Members can mark an alert as acknowledged/resolved.
        allow update: if isMember(familyId);
        allow delete: if isAdmin(familyId);
      }

      match /presence/{uid} {
        allow read: if isMember(familyId);
        // Only you can write your own presence doc.
        allow write: if signedIn() && request.auth.uid == uid && isMember(familyId);
      }
    }

    match /invites/{code} {
      // A joiner (not yet in the family) must be able to read the code
      // to discover which family it belongs to.
      allow read: if signedIn();
      // Only members of the target family may create/delete invite codes.
      allow create, delete: if signedIn() &&
        isMember(request.resource.data.family_id);
    }

    // Per-user index pointing at their family id. Each user may only
    // read/write their own entry. Used by the client to look up the
    // family they belong to without needing to know the id up front.
    match /user_memberships/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
