<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicitly allow Firebase Auth's SharedPreferences and the app's own
  SharedPreferences to persist across backups and OS "data extraction"
  events. Without this, Android 12+ (and aggressive OEMs like Realme UI
  / OriginOS) can silently wipe the auth cache between app launches,
  forcing the user to re-OTP every time they reopen the app.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <include domain="database" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <include domain="database" path="." />
  </device-transfer>
</data-extraction-rules>
